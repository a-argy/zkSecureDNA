pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";
import {SP1Verifier} from "@sp1-contracts/v6.1.0/SP1VerifierGroth16.sol";
import {ISP1Verifier} from "@sp1-contracts/ISP1Verifier.sol";
import {ZkSecureDNARegistry} from "../src/ZkSecureDNARegistry.sol";

/// A real record (generated by crates/zk_prover/examples/record_fixture.rs)
/// verified by SP1's on-chain Groth16 verifier.
contract RecordFixtureTest is Test {
    ZkSecureDNARegistry registry;
    bytes32 constant SCREENER = keccak256("securedna-main");

    bytes32 vkey;
    bytes publicValues;
    bytes proof;
    bytes[] fields;

    function setUp() public {
        string memory json = vm.readFile(string.concat(vm.projectRoot(), "/test/fixtures/record.json"));
        vkey = vm.parseJsonBytes32(json, ".recordVkey");
        publicValues = vm.parseJsonBytes(json, ".publicValues");
        proof = vm.parseJsonBytes(json, ".proof");
        fields = vm.parseJsonBytesArray(json, ".fields");
        uint64 screenedAt = uint64(vm.parseJsonUint(json, ".screenedAt"));
        vm.warp(screenedAt + 1 hours);

        ZkSecureDNARegistry.InitialAuthority[] memory auths = new ZkSecureDNARegistry.InitialAuthority[](1);
        auths[0] = ZkSecureDNARegistry.InitialAuthority(address(this), 1, bytes32(0));
        registry = new ZkSecureDNARegistry(
            ISP1Verifier(address(new SP1Verifier())),
            vkey,
            auths,
            1,
            vm.parseJsonBytes32(json, ".committeeKey"),
            uint32(fields.length),
            7 days
        );
        uint256 pid = registry.propose(
            abi.encodeCall(
                ZkSecureDNARegistry.setScreener,
                (
                    SCREENER,
                    ZkSecureDNARegistry.Screener(
                        "SecureDNA (test)",
                        vm.parseJsonBytes32(json, ".hdbPublicKey"),
                        vm.parseJsonBytes32(json, ".activeSecurityKeyDigest"),
                        vm.parseJsonBytes32(json, ".circuitsDigest"),
                        address(this),
                        true
                    )
                )
            )
        );
        registry.execute(pid);
        registry.publishHdbRoot(SCREENER, vm.parseJsonBytes32(json, ".hdbRoot"));
    }

    function test_real_record_is_accepted() public {
        uint256 gasBefore = gasleft();
        uint256 id = registry.submitRecord(SCREENER, publicValues, proof, fields);
        emit log_named_uint("submitRecord gas", gasBefore - gasleft());
        assertEq(registry.getRecord(id).fieldDigests.length, fields.length);
    }

    function test_record_carries_proven_lookups() public {
        uint256 id = registry.submitRecord(SCREENER, publicValues, proof, fields);
        ZkSecureDNARegistry.Record memory r = registry.getRecord(id);
        assertEq(r.hdbRoot, vm.parseJsonBytes32(vm.readFile("test/fixtures/record.json"), ".hdbRoot"));
        assertEq(r.lookupHits, 0);
    }

    function test_tampered_public_values_are_rejected() public {
        bytes memory pv = publicValues;
        pv[pv.length - 1] ^= 0x01; // flip a bit of the last field digest
        vm.expectRevert();
        registry.submitRecord(SCREENER, pv, proof, fields);
    }

    function test_tampered_proof_is_rejected() public {
        bytes memory p = proof;
        p[p.length - 1] ^= 0x01;
        vm.expectRevert();
        registry.submitRecord(SCREENER, publicValues, p, fields);
    }

    function test_swapped_ciphertext_is_rejected() public {
        bytes[] memory f = fields;
        f[1] = f[2];
        vm.expectRevert(abi.encodeWithSelector(ZkSecureDNARegistry.FieldDigestMismatch.selector, 1));
        registry.submitRecord(SCREENER, publicValues, proof, f);
    }
}
